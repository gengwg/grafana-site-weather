    {
      "id": 9,
      "type": "row",
      "title": "Active official warnings (now, not time-range bound)",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "table",
      "title": "MeteoAlarm: ${meteoalarm_country}",
      "description": "All active warnings for the country from its national met service via MeteoAlarm (CC BY 4.0). Check the area column against your site.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_INFINITY}"
          },
          "type": "xml",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "https://feeds.meteoalarm.org/feeds/meteoalarm-legacy-atom-${meteoalarm_country}",
          "root_selector": "$append([], feed.entry)",
          "columns": [
            {
              "selector": "event",
              "text": "event",
              "type": "string"
            },
            {
              "selector": "severity",
              "text": "severity",
              "type": "string"
            },
            {
              "selector": "areaDesc",
              "text": "area",
              "type": "string"
            },
            {
              "selector": "onset",
              "text": "onset",
              "type": "timestamp"
            },
            {
              "selector": "expires",
              "text": "expires",
              "type": "timestamp"
            },
            {
              "selector": "title",
              "text": "headline",
              "type": "string"
            }
          ],
          "url_options": {
            "method": "GET",
            "headers": [
              {
                "key": "Accept",
                "value": "application/atom+xml, application/xml, text/xml, */*"
              },
              {
                "key": "User-Agent",
                "value": "grafana-site-weather"
              }
            ]
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "event": 0,
              "severity": 1,
              "area": 2,
              "onset": 3,
              "expires": 4,
              "headline": 5
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "onset",
            "desc": true
          }
        ]
      },
      "repeat": "meteoalarm_country",
      "repeatDirection": "h",
      "maxPerRow": 2
    },
    {
      "id": 11,
      "type": "table",
      "title": "US National Weather Service: ${nws_states:csv}",
      "description": "Active NWS alerts for the selected states.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "https://api.weather.gov/alerts/active?area=${nws_states:csv}",
          "root_selector": "$map(features, function($f) { {\"event\": $f.properties.event, \"severity\": $f.properties.severity, \"area\": $f.properties.areaDesc, \"onset\": $f.properties.onset, \"expires\": $f.properties.expires, \"headline\": $f.properties.headline} })",
          "columns": [
            {
              "selector": "event",
              "text": "event",
              "type": "string"
            },
            {
              "selector": "severity",
              "text": "severity",
              "type": "string"
            },
            {
              "selector": "area",
              "text": "area",
              "type": "string"
            },
            {
              "selector": "onset",
              "text": "onset",
              "type": "timestamp"
            },
            {
              "selector": "expires",
              "text": "expires",
              "type": "timestamp"
            },
            {
              "selector": "headline",
              "text": "headline",
              "type": "string"
            }
          ],
          "url_options": {
            "method": "GET",
            "headers": [
              {
                "key": "Accept",
                "value": "application/geo+json"
              },
              {
                "key": "User-Agent",
                "value": "grafana-site-weather"
              }
            ]
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "event": 0,
              "severity": 1,
              "area": 2,
              "onset": 3,
              "expires": 4,
              "headline": 5
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "onset",
            "desc": true
          }
        ]
      }
    }
  ]
}
