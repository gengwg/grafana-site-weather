          "format": "timeseries",
          "url": "${api}?${site}&hourly=precipitation&start_date=${__from:date:YYYY-MM-DD}&end_date=${__to:date:YYYY-MM-DD}&timeformat=unixtime&timezone=UTC",
          "root_selector": "$map(hourly.time, function($t, $i) { {\"time\": $t, \"value\": hourly.precipitation[$i]} })",
          "columns": [
