    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Precipitation",
      "description": "Hourly precipitation sum.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
