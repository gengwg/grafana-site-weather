{
  "__inputs": [
    {
      "name": "DS_INFINITY",
      "label": "Infinity",
      "description": "",
      "type": "datasource",
      "pluginId": "yesoreyeram-infinity-datasource",
      "pluginName": "Infinity"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.4.0"
    },
    {
      "type": "datasource",
      "id": "yesoreyeram-infinity-datasource",
      "name": "Infinity",
      "version": "2.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "geomap",
      "name": "Geomap",
      "version": ""
    }
  ],
  "id": null,
  "uid": "site-weather",
  "title": "Site Weather",
  "description": "Outdoor weather at your sites (data centers, offices, plants) over the dashboard time range, plus active official weather warnings. Sites are dashboard variables; no API keys. Data: Open-Meteo, MeteoAlarm, US NWS.",
  "tags": [
    "weather",
    "open-meteo",
    "infinity"
  ],
  "editable": true,
  "timezone": "",
  "schemaVersion": 39,
  "refresh": "",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "custom",
        "multi": true,
        "includeAll": false,
        "description": "One entry per site: Label : latitude=LAT&longitude=LON. Edit under Dashboard settings > Variables.",
        "query": "Frankfurt : latitude=50.11&longitude=8.68,Toronto : latitude=43.65&longitude=-79.38,Singapore : latitude=1.35&longitude=103.82,Cape Town : latitude=-33.93&longitude=18.42",
        "options": [
          {
            "text": "Frankfurt",
            "value": "latitude=50.11&longitude=8.68",
            "selected": true
          },
          {
            "text": "Toronto",
            "value": "latitude=43.65&longitude=-79.38",
            "selected": true
          },
          {
            "text": "Singapore",
            "value": "latitude=1.35&longitude=103.82",
            "selected": true
          },
          {
            "text": "Cape Town",
            "value": "latitude=-33.93&longitude=18.42",
            "selected": true
          }
        ],
        "current": {
          "text": [
            "Frankfurt",
            "Toronto",
            "Singapore",
            "Cape Town"
          ],
          "value": [
            "latitude=50.11&longitude=8.68",
            "latitude=43.65&longitude=-79.38",
            "latitude=1.35&longitude=103.82",
            "latitude=-33.93&longitude=18.42"
          ]
        }
      },
      {
        "name": "lats",
        "label": "lats",
        "type": "query",
        "hide": 2,
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "sort": 0,
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "${DS_INFINITY}"
        },
        "definition": "latitude list from $site",
        "query": {
          "queryType": "infinity",
          "infinityQuery": {
            "refId": "variable",
            "type": "json",
            "source": "inline",
            "parser": "backend",
            "format": "table",
            "data": "${site:json}",
            "root_selector": "$map($, function($v) { $substringBefore($substringAfter($v & \"&\", \"latitude=\"), \"&\") })",
            "columns": [],
            "url_options": {
              "method": "GET"
            }
          }
        },
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "description": "Derived from the site variable for the map; do not edit."
      },
      {
        "name": "lons",
        "label": "lons",
        "type": "query",
        "hide": 2,
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "sort": 0,
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "${DS_INFINITY}"
        },
        "definition": "longitude list from $site",
        "query": {
          "queryType": "infinity",
          "infinityQuery": {
            "refId": "variable",
            "type": "json",
            "source": "inline",
            "parser": "backend",
            "format": "table",
            "data": "${site:json}",
            "root_selector": "$map($, function($v) { $substringBefore($substringAfter($v & \"&\", \"longitude=\"), \"&\") })",
            "columns": [],
            "url_options": {
              "method": "GET"
            }
          }
        },
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "description": "Derived from the site variable for the map; do not edit."
      },
      {
        "name": "api",
        "label": "Open-Meteo API",
        "type": "custom",
        "multi": false,
        "includeAll": false,
        "description": "Forecast covers the last 92 days plus 16 days ahead. Archive (ERA5) goes back to 1940 with a few days of lag.",
        "query": "forecast (last 92d) : https://api.open-meteo.com/v1/forecast,archive (ERA5 for older windows) : https://archive-api.open-meteo.com/v1/archive",
        "options": [
          {
            "text": "forecast (last 92d)",
            "value": "https://api.open-meteo.com/v1/forecast",
            "selected": true
          },
          {
            "text": "archive (ERA5 for older windows)",
            "value": "https://archive-api.open-meteo.com/v1/archive",
            "selected": false
          }
        ],
        "current": {
          "text": "forecast (last 92d)",
          "value": "https://api.open-meteo.com/v1/forecast"
        }
      },
      {
        "name": "meteoalarm_country",
        "label": "MeteoAlarm countries",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "description": "MeteoAlarm feed names, lowercase country names (germany, france, italy, ...). One table per country.",
        "query": "germany,france",
        "options": [
          {
            "text": "germany",
            "value": "germany",
            "selected": false
          },
          {
            "text": "france",
            "value": "france",
            "selected": false
          }
        ],
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "nws_states",
        "label": "US states (NWS)",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "description": "US state codes for NWS active alerts, e.g. CA, NY.",
        "query": "CA,NY",
        "options": [
          {
            "text": "CA",
            "value": "CA",
            "selected": false
          },
          {
            "text": "NY",
            "value": "NY",
            "selected": false
          }
        ],
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "geomap",
      "title": "Sites, colored by current temperature",
      "description": "One marker per selected site. Color follows the same thresholds as the tiles (orange from 30 C, red from 35 C).",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "https://api.open-meteo.com/v1/forecast?latitude=${lats:csv}&longitude=${lons:csv}&current=temperature_2m&timezone=UTC",
          "root_selector": "$map($, function($r, $i) { {\"site\": $split(\"${site:text}\", \" + \")[$i], \"lat\": $r.latitude, \"lon\": $r.longitude, \"temp\": $r.current.temperature_2m} })",
          "columns": [
            {
              "selector": "site",
              "text": "site",
              "type": "string"
            },
            {
              "selector": "lat",
              "text": "lat",
              "type": "number"
            },
            {
              "selector": "lon",
              "text": "lon",
              "type": "number"
            },
            {
              "selector": "temp",
              "text": "temp",
              "type": "number"
            }
          ],
          "url_options": {
            "method": "GET"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 35
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit",
          "allLayers": true,
          "padding": 10,
          "zoom": 2
        },
        "basemap": {
          "type": "osm-standard",
          "name": "OpenStreetMap"
        },
        "layers": [
          {
            "type": "markers",
            "name": "sites",
            "tooltip": true,
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "showLegend": false,
              "style": {
                "size": {
                  "fixed": 9
                },
                "color": {
                  "field": "temp",
                  "fixed": "green"
                },
                "opacity": 0.9,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                },
                "text": {
                  "field": "site",
                  "fixed": ""
                },
                "textConfig": {
                  "fontSize": 12,
                  "offsetY": -14,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              }
            }
          }
        ],
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": false
        },
        "tooltip": {
          "mode": "details"
        }
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "${site:text}",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": [],
      "repeat": "site"
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Now",
      "description": "Current 2 m air temperature at the site.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 4,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "https://api.open-meteo.com/v1/forecast?${site}&current=temperature_2m&timezone=UTC",
          "root_selector": "current",
          "columns": [
            {
              "selector": "temperature_2m",
              "text": "now",
              "type": "number"
            }
          ],
          "url_options": {
            "method": "GET"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 35
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Temperature",
      "description": "Hourly 2 m air temperature over the dashboard time range.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "gridPos": {
        "x": 4,
        "y": 12,
        "w": 10,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "${api}?${site}&hourly=temperature_2m&start_date=${__from:date:YYYY-MM-DD}&end_date=${__to:date:YYYY-MM-DD}&timeformat=unixtime&timezone=UTC",
          "root_selector": "$map(hourly.time, function($t, $i) { {\"time\": $t, \"value\": hourly.temperature_2m[$i]} })",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp_epoch_s"
            },
            {
              "selector": "value",
              "text": "temperature",
              "type": "number"
            }
          ],
          "url_options": {
            "method": "GET"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Apparent temperature",
      "description": "Feels-like temperature (humidity, wind, radiation).",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "gridPos": {
        "x": 14,
        "y": 12,
        "w": 10,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "${api}?${site}&hourly=apparent_temperature&start_date=${__from:date:YYYY-MM-DD}&end_date=${__to:date:YYYY-MM-DD}&timeformat=unixtime&timezone=UTC",
          "root_selector": "$map(hourly.time, function($t, $i) { {\"time\": $t, \"value\": hourly.apparent_temperature[$i]} })",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp_epoch_s"
            },
            {
              "selector": "value",
              "text": "apparent temperature",
              "type": "number"
            }
          ],
          "url_options": {
            "method": "GET"
          }
        }
      ],
      "fieldConfig": {
